# ─── Video Source ───────────────────────────────────────────────────────────
# default: webcam (use_webcam=true in config.development.json)
#
# Change to RTSP camera:
#   1. Set RTSP_VIDEO_PATH → will override automatically (use_webcam=false)
#   2. Comment out this line or delete it → back to webcam

# Force webcam even if video_path is set in config (not necessary if using RTSP_VIDEO_PATH)
# USE_WEBCAM=true

# Detection runs on the camera sub-stream (848x480) for lower latency.
# Main stream is 1920x1080: swap "stream2" -> "stream1" for higher detail.
RTSP_VIDEO_PATH=rtsp://user:password@192.168.1.100:554/stream2

# ─── Database ───────────────────────────────────────────────────────────────
# Supabase: use the host and database values from Project Settings > Database
DATABASE_HOST=db.<project-ref>.supabase.co
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=<database-password>
DATABASE_NAME=postgres